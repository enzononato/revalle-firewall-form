# Conexao com o Postgres da sua VPS.
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# Use SSL na conexao com o Postgres? (true/false)
# Se o Postgres estiver na mesma VPS / mesma rede do EasyPanel, deixe false.
PGSSL=false

# Porta interna do container Node. O EasyPanel faz o proxy do dominio para essa porta.
# Pode deixar 3000 mesmo que voce tenha outros apps - cada container tem rede isolada.
PORT=3000

# URL publica da aplicacao. Usada para montar os botoes de Aprovar/Reprovar no e-mail da TI.
# Ex: https://agente-revalle-firewall-form.tj0vdr.easypanel.host (sem barra no final)
APP_URL=https://seu-dominio.easypanel.host

# ── E-mail (SMTP) ────────────────────────────────────────────────────────────
# Servidor de saida do cPanel da Revalle.
SMTP_HOST=mail.revalle.com.br
SMTP_PORT=465
SMTP_USER=projetos.ti@revalle.com.br
SMTP_PASS=sua_senha_aqui

# Para quem enviar as notificacoes do formulario de firewall.
# Pode ser um ou varios separados por virgula:
# Ex: projetos.ti@revalle.com.br,outro@revalle.com.br
SMTP_TO=projetos.ti@revalle.com.br

# Para quem enviar as notificacoes do formulario de contratos.
SMTP_TO_CONTRATOS=contratos@revalle.com.br
